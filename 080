<!DOCTYPE html>
<html>
<head>
    <title>Five Part Layout using DIV</title>
</head>

<body style="margin:0; font-family:Arial;">

    <!-- Header -->
    <div style="width:100vw; height:10vh; background-color:lightblue;
                text-align:center; line-height:10vh;
                font-size:3rem; font-weight:bold;">
    chelsea sharon
    </div>

    <!-- Main Content -->
    <div style="width:100%; height:80vh; margin:auto;">

        <!-- Left Section -->
        <div style="width:20%; height:100%; background-color:palevioletred;
                    float:left; text-align:center;
                    line-height:80vh; font-size:1.5em;">
            98491420 @gmail
        </div>

        <!-- Center Section -->
        <div style="width:60%; height:100%; background-color:white;
                    float:left; text-align:center;
                    line-height:80vh; font-size:1.5em;">
                    
           Hello! myself chels...
        </div>

        <!-- Right Section -->
        <div style="width:20%; height:100%; background-color:aquamarine;
                    float:left; text-align:center;
                    line-height:80vh; font-size:1.5em;">
           <a href="https://www.linkedin.com/in/john-doe-123456789/"
   target="_blank"
   style="text-decoration:none; color:black; font-weight:bold;">
    View My LinkedIn Profile
</a>
        </div>

    </div>

    <!-- Footer -->
    <div style="clear:both; width:100vw; height:10vh;
                background-color:lightgray;
                text-align:center; line-height:10vh;
                font-size:1.8rem; font-weight:bold;">
        thank you for visiting my page
    </div>

</body>
</html>